<root padding="32" gap="18" bg="#0c1c30">
  <label class="title" width="100%" height="44px" text="Profile" />
  <column gap="6">
    <label class="caption" text="Display name" />
    <input id="name" class="field" width="100%" height="40px" bind-text="name" placeholder="What should we call you?" tab-index="0" />
  </column>
  <row gap="12" align="center">
    <toggle id="dark" class="control" width="48px" height="28px" bind-checked="dark" tab-index="1" />
    <label class="caption" text="Dark mode" />
  </row>
  <column gap="6">
    <label class="caption" text="Volume" />
    <slider id="volume" class="control" width="100%" height="28px" bind-value="volume" max="1" min="0" tab-index="2" value="0.5" />
  </column>
  <label class="echo" width="100%" height="40px" text="(waiting for input...)" bind-text="status" />
  <script src="main.cdl" />
</root>
